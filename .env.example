# Zorunlu: Postgres baglantisi
DATABASE_URL=

# Otomatik uretilir (bos birakin):
SESSION_SECRET=
JWT_SECRET=

NODE_ENV=production
BASE_PATH=/
PORT=8080

# Zorunlu production admin hesabi:
ADMIN_EMAIL=
ADMIN_USERNAME=
ADMIN_PASSWORD=

# WhatsApp — Railway volume mount yolu kullanin:
WWEBJS_AUTH_PATH=./.wwebjs_auth
WA_AUTO_CONNECT=1
# Docker/Railway imajinda:
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

# Opsiyonel — Telegram (env isimleri bilerek ters):
# Telegram (admin panel -> Telegram Hesabi)
# https://my.telegram.org/apps adresinden alin
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=your_api_hash_here
TELEGRAM_BOT_TOKEN=
