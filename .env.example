# Docker disi/Railway için zorunlu Postgres bağlantısı:
DATABASE_URL=
POSTGRES_USER=ozelguvenlik
POSTGRES_PASSWORD=
POSTGRES_DB=ozelguvenlik

# Production'da kalıcı ve en az 32 karakter olmalı:
JWT_SECRET=
APP_DOMAIN=ozelguvenlik.online
APP_ORIGINS=https://ozelguvenlik.online
ACME_EMAIL=
TRUST_PROXY_HOPS=1
# HTTPS ve redirect doğrulandıktan sonra 1:
ENABLE_HSTS=0
CRON_SECRET=

NODE_ENV=production
BASE_PATH=/
PORT=8080
PG_POOL_MAX=10

# Ayrı servis geçişi:
# Web servisi: RUN_BOT_WORKERS=0
# Singleton worker: BOT_PLATFORMS=telegram,whatsapp,eleman ve PG_POOL_MAX=4
RUN_BOT_WORKERS=1
BOT_PLATFORMS=telegram,whatsapp,eleman
WORKER_HEALTH_PORT=9090
# Yalnız kontrollü migration adımında 1 yapın; normal boot'ta kapalı kalmalı.
RUN_SCHEMA_PUSH=0

# Zorunlu production admin hesabi:
ADMIN_EMAIL=
ADMIN_USERNAME=
ADMIN_PASSWORD=

# WhatsApp — Railway volume mount yolu kullanin:
WWEBJS_AUTH_PATH=./.wwebjs_auth
WA_AUTO_CONNECT=1
# Docker/Railway imajinda:
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
ELEMAN_REQUEST_TIMEOUT_MS=20000
ELEMAN_REQUEST_RETRIES=3

# Opsiyonel — Telegram (env isimleri bilerek ters):
# Telegram (admin panel -> Telegram Hesabi)
# https://my.telegram.org/apps adresinden alin
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=your_api_hash_here
TELEGRAM_BOT_TOKEN=

# Opsiyonel:
LOG_LEVEL=info
DATABASE_SSL=false
DATABASE_TLS_REJECT_UNAUTHORIZED=true
DATABASE_CA_CERT_FILE=
OPENAI_API_KEY=
LOCATION_AI_API_KEY=
LOCATION_AI_ENABLED=false
LOCATION_AI_MODEL=gpt-4o-mini
SCRAPER_INITIAL_DAYS=30
SCRAPER_PAGES_PER_CYCLE=4
TELEGRAM_USE_WSS=1
