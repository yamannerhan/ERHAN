{
  "name": "@workspace/api-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "set NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "pnpm --filter @workspace/db run build && node ./build.mjs",
    "start": "node --env-file-if-exists=../../.env --enable-source-maps ./dist/index.mjs",
    "start:web": "node --env-file-if-exists=../../.env --enable-source-maps ./dist/index.mjs",
    "start:worker": "node --env-file-if-exists=../../.env --enable-source-maps ./dist/bot-worker.mjs",
    "start:worker:telegram": "node --env-file-if-exists=../../.env --enable-source-maps ./dist/bot-worker.mjs --platform=telegram",
    "start:worker:whatsapp": "node --env-file-if-exists=../../.env --enable-source-maps ./dist/bot-worker.mjs --platform=whatsapp",
    "start:worker:eleman": "node --env-file-if-exists=../../.env --enable-source-maps ./dist/bot-worker.mjs --platform=eleman",
    "typecheck": "pnpm --filter @workspace/db run build && tsc -p tsconfig.json --noEmit",
    "test": "pnpm run test:whatsapp && pnpm run test:eleman && pnpm run test:security && pnpm run test:seo && pnpm run test:job-match && pnpm run test:news && pnpm run test:url-pool",
    "test:whatsapp": "tsx --test src/modules/whatsapp/whatsapp.test.ts",
    "test:eleman": "tsx --test src/services/eleman-client.test.ts",
    "test:security": "tsx --test src/lib/security.test.ts",
    "test:seo": "tsx --test src/lib/seo-sitemap.test.ts",
    "test:job-match": "tsx --test src/lib/job-match/scoring.test.ts",
    "test:news": "tsx --test src/news/utils.test.ts",
    "test:url-pool": "tsx --test src/workers/url-pool-filter.test.ts",
    "audit:bot-db": "tsx src/commands/botDatabaseAudit.ts",
    "locations:sync": "pnpm exec tsx --tsconfig ./tsconfig.json ./src/commands/locationsSync.ts",
    "jobs:reclassify-locations": "pnpm exec tsx --tsconfig ./tsconfig.json ./src/commands/jobsReclassifyLocations.ts",
    "test:location-classifier-v2": "pnpm exec tsx --tsconfig ./tsconfig.json ./scripts/test-location-classifier-v2.ts",
    "test:moderation-rbac": "pnpm exec tsx --tsconfig ./tsconfig.json ./scripts/test-moderation-rbac.ts"
  },
  "dependencies": {
    "@types/compression": "^1.8.1",
    "@types/multer": "^2.1.0",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "bcryptjs": "^3.0.3",
    "bufferutil": "^4.1.0",
    "cheerio": "^1.2.0",
    "compression": "^1.8.1",
    "connect-pg-simple": "^10.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "pg": "^8.20.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "puppeteer": "^24.0.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.34.5",
    "socket.io": "^4.8.3",
    "telegram": "^2.26.22",
    "tesseract.js": "^7.0.0",
    "utf-8-validate": "^6.0.6",
    "web-push": "^3.6.7",
    "whatsapp-web.js": "1.34.7",
    "ws": "^8.18.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.3.3",
    "@types/web-push": "^3.6.4",
    "esbuild": "0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0",
    "tsx": "catalog:"
  }
}
